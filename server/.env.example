NODE_ENV=development
PORT=5000

# Local development. Replace with MongoDB Atlas on Render.
MONGODB_URI=mongodb://127.0.0.1:27017/argo_calendar
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h

# Created automatically on the first server startup.
OWNER_NAME=Argo HR Administrator
OWNER_EMAIL=hrargolabs@gmail.com
OWNER_PASSWORD=ChangeMeImmediately123!
SEED_DEMO_DATA=true

TIMEZONE=Asia/Manila
GOOGLE_CALENDAR_ENABLED=false

# The application remains functional when email is disabled.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=Argo Calendar <onboarding@resend.dev>
REMINDER_SECRET=replace-with-a-different-long-random-secret

FORM_WEBHOOK_SECRET=replace-with-another-long-random-secret
